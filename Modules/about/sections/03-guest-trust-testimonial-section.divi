<!-- wp:divi/text {"module":{"meta":{"adminLabel":{"desktop":{"value":"Review Content"}}},"decoration":{"layout":{"desktop":{"value":{"display":"block"}}}}},"content":{"innerContent":{"desktop":{"value":"<div style=\"display:flex;flex-direction:column;align-items:center;text-align:center;width:100%;\"><div style=\"font-size:24px;color:#fcd21d;letter-spacing:6px;line-height:1;margin-bottom:8px;\" aria-hidden=\"true\">★★★★★</div><span style=\"display:block;font-family:Montserrat,sans-serif;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#b35f00;margin-bottom:18px;\">5-Star Rated Family Transportation</span><div style=\"font-size:42px;line-height:1;color:#fcd21d;font-family:Georgia,serif;margin-bottom:-10px;\" aria-hidden=\"true\">&ldquo;</div><blockquote style=\"margin:0;padding:0;border:none;\"><p style=\"font-family:Montserrat,sans-serif;font-size:19px;font-weight:500;line-height:1.75em;color:#353740;max-width:740px;margin:0 0 22px;\">We are a family business with many years of experience providing safe, punctual, and enjoyable transportation to our customers. From Punta Cana International Airport (PUJ) to resorts across the Dominican Republic, we make sure you and your family travel with complete peace of mind.</p></blockquote><div style=\"width:44px;height:3px;background:#fcd21d;border-radius:2px;margin:0 auto 18px;\"></div><p style=\"margin:0 0 4px;font-family:Montserrat,sans-serif;font-size:15px;font-weight:700;letter-spacing:1.5px;color:#141630;text-transform:uppercase;\">B.D Star Transportation &amp; Shuttle</p><p style=\"margin:0;font-family:Montserrat,sans-serif;font-size:13px;font-weight:400;color:#5f6877;\">Punta Cana International Airport (PUJ) &bull; Dominican Republic</p><div class=\"bd-about-review-badges\"><div class=\"bd-family-trust-item\"><svg viewBox=\"0 0 20 20\" width=\"15\" height=\"15\" fill=\"none\" style=\"flex-shrink:0;\" aria-hidden=\"true\"><path d=\"m4 10 4 4 8-8\" stroke=\"#fcd21d\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>100% Private Transfers</span></div><div class=\"bd-family-trust-item\"><svg viewBox=\"0 0 20 20\" width=\"15\" height=\"15\" fill=\"none\" style=\"flex-shrink:0;\" aria-hidden=\"true\"><path d=\"m4 10 4 4 8-8\" stroke=\"#fcd21d\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>Direct Resort Routes</span></div><div class=\"bd-family-trust-item\"><svg viewBox=\"0 0 20 20\" width=\"15\" height=\"15\" fill=\"none\" style=\"flex-shrink:0;\" aria-hidden=\"true\"><path d=\"m4 10 4 4 8-8\" stroke=\"#fcd21d\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>Child Seats on Request</span></div></div></div>"}}},"builderVersion":"5.11.1"} /-->
