<!-- wp:divi/text {"module":{"decoration":{"layout":{"desktop":{"value":{"display":"block"}}}}},"content":{"decoration":{"headingFont":{"h2":{"font":{"desktop":{"value":{"family":"Montserrat","weight":"700","color":"#353740","size":"34px","lineHeight":"1.3em"}}}}}},"innerContent":{"desktop":{"value":"\u003ch2\u003eEverything You Need to Know About BD Star Transport\u003c/h2\u003e\u003cp\u003eFind answers to the most common questions about our transport services in Punta Cana and the Dominican Republic.\u003c/p\u003e"}}},"builderVersion":"5.0.0-public-beta.1"} /-->

<!-- wp:divi/text {"module":{"decoration":{"spacing":{"desktop":{"value":{"margin":{"top":"20px","right":"","bottom":"","left":"","syncVertical":"off","syncHorizontal":"off"}}},"phone":{"value":{"margin":{"top":"11px","bottom":"","left":"","right":"","syncVertical":"off","syncHorizontal":"off"}}}},"layout":{"desktop":{"value":{"display":"block"}}}}},"content":{"decoration":{"bodyFont":{"body":{"font":{"desktop":{"value":{"family":"Montserrat","weight":"400","color":"#353740","size":"16px","lineHeight":"1.7em"}}}}}},"innerContent":{"desktop":{"value":"\u003cdiv class=\u0022bd-contact-faq-card\u0022 style=\u0022background:var(\u002d\u002dbd-inline-card-surface,#ffffff);border:1px solid var(\u002d\u002dbd-inline-card-border,#e4e6ef);border-left:3px solid #345EC6;border-radius:10px;padding:20px 24px;margin:0 0 14px;\u0022\u003e\u003cp style=\u0022margin:0 0 8px;font-weight:700;color:var(\u002d\u002dbd-inline-card-heading,#141630);\u0022\u003eWhat services do you offer?\u003c/p\u003e\u003cp style=\u0022margin:0;color:var(\u002d\u002dbd-inline-card-body,#747d88);line-height:1.7em;\u0022\u003eWe provide secure and reliable transport services anywhere in Punta Cana and other regions in the Dominican Republic.\u003c/p\u003e\u003c/div\u003e\u003cdiv class=\u0022bd-contact-faq-card\u0022 style=\u0022background:var(\u002d\u002dbd-inline-card-surface,#ffffff);border:1px solid var(\u002d\u002dbd-inline-card-border,#e4e6ef);border-left:3px solid #345EC6;border-radius:10px;padding:20px 24px;margin:0 0 14px;\u0022\u003e\u003cp style=\u0022margin:0 0 8px;font-weight:700;color:var(\u002d\u002dbd-inline-card-heading,#141630);\u0022\u003eHow can I book a trip?\u003c/p\u003e\u003cp style=\u0022margin:0;color:var(\u002d\u002dbd-inline-card-body,#747d88);line-height:1.7em;\u0022\u003eYou can book a trip through our website or by contacting us directly via phone or email.\u003c/p\u003e\u003c/div\u003e\u003cdiv class=\u0022bd-contact-faq-card\u0022 style=\u0022background:var(\u002d\u002dbd-inline-card-surface,#ffffff);border:1px solid var(\u002d\u002dbd-inline-card-border,#e4e6ef);border-left:3px solid #345EC6;border-radius:10px;padding:20px 24px;margin:0 0 14px;\u0022\u003e\u003cp style=\u0022margin:0 0 8px;font-weight:700;color:var(\u002d\u002dbd-inline-card-heading,#141630);\u0022\u003eWhat are your operating hours?\u003c/p\u003e\u003cp style=\u0022margin:0;color:var(\u002d\u002dbd-inline-card-body,#747d88);line-height:1.7em;\u0022\u003eWe operate 24/7 to accommodate your travel needs at any time of day or night.\u003c/p\u003e\u003c/div\u003e\u003cdiv class=\u0022bd-contact-faq-card\u0022 style=\u0022background:var(\u002d\u002dbd-inline-card-surface,#ffffff);border:1px solid var(\u002d\u002dbd-inline-card-border,#e4e6ef);border-left:3px solid #345EC6;border-radius:10px;padding:20px 24px;margin:0 0 14px;\u0022\u003e\u003cp style=\u0022margin:0 0 8px;font-weight:700;color:var(\u002d\u002dbd-inline-card-heading,#141630);\u0022\u003eDo you offer airport transfers?\u003c/p\u003e\u003cp style=\u0022margin:0;color:var(\u002d\u002dbd-inline-card-body,#747d88);line-height:1.7em;\u0022\u003eYes, we provide convenient airport transfer services to and from local airports for our clients.\u003c/p\u003e\u003c/div\u003e\u003cdiv class=\u0022bd-contact-faq-card\u0022 style=\u0022background:var(\u002d\u002dbd-inline-card-surface,#ffffff);border:1px solid var(\u002d\u002dbd-inline-card-border,#e4e6ef);border-left:3px solid #345EC6;border-radius:10px;padding:20px 24px;margin:0 0 14px;\u0022\u003e\u003cp style=\u0022margin:0 0 8px;font-weight:700;color:var(\u002d\u002dbd-inline-card-heading,#141630);\u0022\u003eWhat is your cancellation policy?\u003c/p\u003e\u003cp style=\u0022margin:0;color:var(\u002d\u002dbd-inline-card-body,#747d88);line-height:1.7em;\u0022\u003eCancellations can be made 24 hours prior to your trip for a full refund without any charges.\u003c/p\u003e\u003c/div\u003e\u003cdiv class=\u0022bd-contact-faq-card\u0022 style=\u0022background:var(\u002d\u002dbd-inline-card-surface,#ffffff);border:1px solid var(\u002d\u002dbd-inline-card-border,#e4e6ef);border-left:3px solid #345EC6;border-radius:10px;padding:20px 24px;margin:0 0 14px;\u0022\u003e\u003cp style=\u0022margin:0 0 8px;font-weight:700;color:var(\u002d\u002dbd-inline-card-heading,#141630);\u0022\u003eAre child safety seats available?\u003c/p\u003e\u003cp style=\u0022margin:0;color:var(\u002d\u002dbd-inline-card-body,#747d88);line-height:1.7em;\u0022\u003eYes, all our vehicles are equipped with child safety seats upon request to ensure your family's safety.\u003c/p\u003e\u003c/div\u003e"}}},"builderVersion":"5.0.0-public-beta.1"} /-->
