<!-- wp:divi/text {"module":{"meta":{"adminLabel":{"desktop":{"value":"Trust Body & Grid"}}},"decoration":{"layout":{"desktop":{"value":{"display":"block"}}}}},"content":{"innerContent":{"desktop":{"value":"<div class=\"bd-family-trust-body\"><span style=\"display:inline-block;font-family:Montserrat,sans-serif;font-size:12px;font-weight:700;color:#de7e0a;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px;\">Exclusive Family Travel</span><h2 style=\"margin:0 0 10px;font-family:Montserrat,sans-serif;font-size:32px;font-weight:700;color:#353740;line-height:1.25em;letter-spacing:0.01em;text-transform:uppercase;\">Family Private &amp; Group Trips</h2><p style=\"margin:0 0 20px;font-family:Montserrat,sans-serif;font-weight:400;color:#747d88;font-size:15px;line-height:1.65em;\">Travel together on your own schedule without the stress of crowded shuttles. Dedicated private vans and minibuses tailored to your family's baggage, comfort, and schedule.</p><div class=\"bd-family-trust-grid\"><div class=\"bd-family-trust-item\"><div class=\"bd-family-trust-icon\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"#fcd21d\" aria-hidden=\"true\"><path d=\"M3.375 4.5C2.339 4.5 1.5 5.34 1.5 6.375V13.5h1.564a3.375 3.375 0 016.622 0h4.628a3.375 3.375 0 016.622 0H22.5V9.75a3.375 3.375 0 00-3.375-3.375h-2.25V4.5H3.375zM14.344 15a1.875 1.875 0 103.75 0 1.875 1.875 0 00-3.75 0zM5.906 15a1.875 1.875 0 103.75 0 1.875 1.875 0 00-3.75 0z\"/></svg></div><div class=\"bd-family-trust-text\"><strong>Spacious Modern Fleet</strong><span>Air-conditioned vans with ample legroom</span></div></div><div class=\"bd-family-trust-item\"><div class=\"bd-family-trust-icon\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"#fcd21d\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 6a.75.75 0 00-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 000-1.5h-3.75V6z\"/></svg></div><div class=\"bd-family-trust-text\"><strong>Flexible Itineraries</strong><span>Custom stops, grocery runs &amp; timing</span></div></div><div class=\"bd-family-trust-item\"><div class=\"bd-family-trust-icon\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"#fcd21d\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12.516 2.17a.75.75 0 00-1.032 0 11.209 11.209 0 01-7.877 3.08.75.75 0 00-.722.515A12.74 12.74 0 002.25 9.75c0 5.942 4.064 10.933 9.563 12.348a.749.749 0 00.374 0c5.499-1.415 9.563-6.406 9.563-12.348 0-1.39-.223-2.73-.635-3.985a.75.75 0 00-.722-.516l-.143.001c-2.996 0-5.717-1.17-7.734-3.08zm3.094 8.016a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z\"/></svg></div><div class=\"bd-family-trust-text\"><strong>Licensed &amp; Insured</strong><span>Full commercial passenger liability</span></div></div><div class=\"bd-family-trust-item\"><div class=\"bd-family-trust-icon\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"#fcd21d\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M4.848 2.772A49.11 49.11 0 0112 2.25c2.43 0 4.817.177 7.152.522 1.45.213 2.598 1.34 2.84 2.775a49.65 49.65 0 010 12.906c-.242 1.435-1.39 2.562-2.84 2.775a49.033 49.033 0 01-5.632.488l-4.197 3.148a.75.75 0 01-1.2-.6V21.1a49.336 49.336 0 01-3.275-.377C3.398 20.51 2.25 19.383 2.008 17.948a49.65 49.65 0 010-12.906c.242-1.435 1.39-2.562 2.84-2.775z\"/></svg></div><div class=\"bd-family-trust-text\"><strong>Bilingual Chauffeurs</strong><span>Friendly English and Spanish support</span></div></div></div></div>"}}},"builderVersion":"5.11.1"} /-->
