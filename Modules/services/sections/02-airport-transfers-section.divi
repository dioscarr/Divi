<!-- wp:divi/code {"module":{"meta":{"adminLabel":{"desktop":{"value":"Smooth Services Section Scroll"}}}},"content":{"innerContent":{"desktop":{"value":"<style>html{scroll-behavior:auto;}.bd-services-feature-section .bd-family-trust-body>span{display:none!important;}.bd-services-feature-section .bd-family-trust-item{background:transparent!important;border:0!important;box-shadow:none!important;}.bd-services-feature-section{scroll-margin-top:96px;}@media(max-width:767px){.bd-services-feature-section{scroll-margin-top:76px;}}</style><script>(function(){var ran=false;function scrollToSection(){if(ran)return;ran=true;var params=new URLSearchParams(window.location.search);var key=params.get('section');var hash=window.location.hash.replace(/^#/,'');if(!key)key=hash;if(!key)return;var target=document.getElementById(key);if(!target)return;history.scrollRestoration='manual';requestAnimationFrame(function(){requestAnimationFrame(function(){var offset=window.matchMedia('(max-width:767px)').matches?76:96;var top=target.getBoundingClientRect().top+window.pageYOffset-offset;window.scrollTo({top:top,behavior:'auto'});if(params.get('section'))history.replaceState(null,'',window.location.pathname+'#'+key);});});}if(document.readyState==='complete')scrollToSection();else window.addEventListener('load',scrollToSection,{once:true});})();</script>"}}},"builderVersion":"5.11.1"} /-->
