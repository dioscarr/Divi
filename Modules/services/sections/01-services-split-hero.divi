<!-- wp:divi/code {"module":{"meta":{"adminLabel":{"desktop":{"value":"Services Hero Critical Geometry"}}},"decoration":{"spacing":{"desktop":{"value":{"margin":{"top":"0px","right":"0px","bottom":"0px","left":"0px","syncVertical":"off","syncHorizontal":"off"}}}}}},"content":{"innerContent":{"desktop":{"value":"<style id=\"bd-services-hero-critical-geometry\">\n/* Shared closed-hero geometry: keep identical on all four pages. */\n#main-content .et_pb_section_0.et_pb_section:not(.is-contact-fullscreen){padding:0!important;\n & .et_pb_row_0.et_pb_row:not(.is-form-open){width:100%!important;max-width:100%!important;padding:0!important;margin:0!important;display:flex!important;flex-wrap:nowrap!important;align-items:flex-start!important;transform:none!important;\n  &>.et_pb_column{box-sizing:border-box;margin:0!important;flex:0 0 50%!important;width:50%!important;max-width:50%!important}\n  &>.et_pb_column:nth-child(1){padding:5vw 4vw!important;height:auto!important;display:flex!important;flex-direction:column!important;justify-content:center!important}\n  &>.et_pb_column:nth-child(2){padding:32px 4vw 24px!important;display:flex!important;flex-direction:column!important;justify-content:flex-start!important;align-items:center!important;align-self:flex-start!important;height:auto!important;min-height:620px!important;max-height:none!important;overflow:visible!important}\n  &>.et_pb_column:nth-child(3),&>.et_pb_column:nth-child(2)>.et_pb_text:has(.bd-contact-hero-slide-head){display:none!important}\n  & .et_pb_slider_0{box-sizing:border-box;width:100%!important;max-width:100%!important;height:500px!important;min-height:500px!important;flex-shrink:0!important;margin:0!important;transform:none!important}\n  & .et_pb_slider_0 .et_pb_slide{box-sizing:border-box;height:500px!important;min-height:500px!important;padding:0!important}\n  @media(max-width:980px){flex-direction:column!important;\n   &>.et_pb_column{flex:0 0 auto!important;width:100%!important;max-width:100%!important}\n   &>.et_pb_column:nth-child(1){height:440px!important;min-height:440px!important;padding:32px 4vw!important;gap:0!important;\n    &>.et_pb_text{margin:0 0 16px!important;flex-shrink:0!important}\n    & .et_pb_text_inner,& p{font-size:inherit!important;line-height:inherit!important;letter-spacing:inherit!important}\n    & h1{font-size:40px!important;line-height:1.2!important;padding-bottom:0!important}\n    &>.et_pb_text:nth-child(3){font-size:18px!important;line-height:1.6!important}\n   }\n  }\n  @media(max-width:767px){\n   &>.et_pb_column:nth-child(1){height:clamp(420px,calc(800px - 75vw),560px)!important;min-height:0!important;padding:24px 4vw!important;\n    &>.et_pb_text{margin-bottom:12px!important}\n    &>.et_pb_text:first-of-type{font-size:12px!important;line-height:1.5!important;letter-spacing:2px!important}\n    & h1{font-size:clamp(24px,7vw,32px)!important}\n    &>.et_pb_text:nth-child(3){font-size:16px!important;line-height:1.6!important}\n   }\n   &>.et_pb_column:nth-child(2){padding-top:24px!important;min-height:492px!important}\n   & .et_pb_slider_0,& .et_pb_slider_0 .et_pb_slide{height:380px!important;min-height:380px!important}\n  }\n }\n}\n</style>"}}},"builderVersion":"5.11.1"} /-->
