lue":{"image":{"url":"https://cfplxlfjp1i96vih.public.blob.vercel-storage.com/tours/4b7182fc-2041-4f02-a7cb-c34a56b9ae8f/temp-1773221307550/cover-1773221307550-santo-domingo-hNAZxbWr2TpUyIGwAKGOzPWyPAq8Ae.png","position":"center","size":"cover","repeat":"no-repeat","parallax":{"enabled":"off"}}}}},"spacing":{"desktop":{"value":{"padding":{"top":"210px","right":"0px","bottom":"210px","left":"0px","syncVertical":"on","syncHorizontal":"on"}}},"tablet":{"value":{"padding":{"top":"210px","bottom":"210px","left":"0px","right":"0px","syncVertical":"on","syncHorizontal":"on"}}},"phone":{"value":{"padding":{"top":"160px","bottom":"160px","left":"0px","right":"0px","syncVertical":"on","syncHorizontal":"on"}}}}}},"builderVersion":"5.11.1"} /--><!-- /wp:divi/slider -->
<!-- wp:divi/button  {"module":{"decoration":{"layout":{"desktop":{"value":{"display":"block"}}},"sizing":{"desktop":{"value":{"alignment":"center"}}},"spacing":{"desktop":{"value":{"margin":{"top":"18px","right":"auto","bottom":"0px","left":"auto"}}},"tablet":{"value":{"margin":{"top":"16px","right":"auto","bottom":"0px","left":"auto"}}},"phone":{"value":{"margin":{"top":"14px","right":"auto","bottom":"0px","left":"auto"}}}}},"attributes":{"desktop":{"value":{"attributes":[{"id":"bdstar-hero-history-button","name":"class","value":"bd-hero-history-button","adminLabel":"CSS Class"}]}}}},"button":{"innerContent":{"desktop":{"value":{"linkUrl":"#bdstar-video","text":"Watch Our History"}},"phone":{"value":{"linkUrl":"#bdstar-video","text":"Watch History"}}},"decoration":{"button":{"desktop":{"value":{"enable":"on","icon":{"settings":{"unicode":"&#x45;","type":"divi","weight":"400"}}}}},"font":{"font":{"desktop":{"value":{"color":"#ffffff","letterSpacing":"2px","family":"Montserrat","weight":"700","capitalization":"uppercase","size":"14px","lineHeight":"1.2em"},"hover":{"color":"#ffffff","letterSpacing":"2px"}},"phone":{"value":{"color":"#ffffff","letterSpacing":"0.8px","family":"Montserrat","weight":"700","capitalization":"uppercase","size":"12px","lineHeight":"1.25em","textWrap":"nowrap"}}}},"border":{"desktop":{"value":{"styles":{"all":{"width":"4px","color":"#ffffff"}},"radius":{"sync":"on","topLeft":"100px","topRight":"100px","bottomRight":"100px","bottomLeft":"100px"}},"hover":{"styles":{"all":{"color":"#ffffff"}}}}},"background":{"desktop":{"hover":{"color":"rgba(20,22,48,0.68)","enableColor":"on"},"value":{"color":"rgba(20,22,48,0.48)"}}},"spacing":{"phone":{"value":{"padding":{"top":"12px","right":"16px","bottom":"12px","left":"16px","syncVertical":"on","syncHorizontal":"on"}}}}}},"builderVersion":"5.0.0-public-beta.1","locked":{"desktop":{"value":"off"}}} /-->
<!-- wp:divi/code  {"module":{"meta":{"adminLabel":{"desktop":{"value":"BD Video Modal"}}},"decoration":{"layout":{"desktop":{"value":{"display":"block"}}}}},"content":{"innerContent":{"desktop":{"value":"<style>\nbody.bd-video-modal-open{overflow:hidden;}\n#bdstar-video{box-sizing:border-box;width:min(420px,50vh,calc(100vw - 32px));max-width:none;max-height:90vh;margin:auto;padding:0;overflow:hidden;background:#090b14;border:1px solid rgba(255,255,255,.24);border-radius:12px;box-shadow:0 28px 90px rgba(0,0,0,.62);color:#fff;}\n#bdstar-video:not([open]){display:none;}\n#bdstar-video[open]{display:block;}\n#bdstar-video::backdrop{background:rgba(12,16,31,.80);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);}\n#bdstar-video-dialog{position:relative;width:100%;aspect-ratio:464/832;overflow:hidden;background:#090b14;}\n#bd-modal-video{display:block;width:100%;height:100%;background:#090b14;object-fit:contain;}\n#bd-video-poster{position:absolute;inset:0;z-index:2;width:100%;height:100%;padding:0;border:0;cursor:pointer;overflow:hidden;background:#141630;}\n#bd-video-poster[hidden]{display:none!important;}\n#bd-video-poster img{display:block;width:100%;height:100%;object-fit:cover;}\n#bd-video-poster:after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,12,25,.08),rgba(8,12,25,.42));}\n#bd-video-play-icon{position:absolute;z-index:3;top:50%;left:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:82px;height:82px;border:2px solid rgba(255,255,255,.88);border-radius:50%;background:#141630;color:#fff;font:700 31px/1 Arial,sans-serif;box-shadow:0 14px 36px rgba(0,0,0,.42);text-indent:5px;}\n#bd-video-play-label{position:absolute;z-index:3;left:16px;right:16px;bottom:42px;color:#fff;font:700 14px/1.3 Montserrat,Arial,sans-serif;letter-spacing:2px;text-align:center;text-transform:uppercase;text-shadow:0 2px 12px rgba(0,0,0,.85);}\n#bd-video-modal-close{position:absolute;z-index:5;top:12px;right:12px;display:grid;place-items:center;width:44px;height:44px;padding:0;border:1px solid rgba(255,255,255,.55);border-radius:50%;cursor:pointer;background:rgba(20,22,48,.88);color:#fff;font:300 30px/1 Arial,sans-serif;box-shadow:0 8px 22px rgba(0,0,0,.32);}\n#bd-video-modal-close:focus-visible,#bd-video-poster:focus-visible{outline:3px solid #141630;outline-offset:3px;}\n@media(max-width:767px){#bdstar-video{width:min(390px,50vh,calc(100vw - 24px));max-height:88vh;border-radius:12px;}#bd-video-play-icon{width:70px;height:70px;font-size:27px;}}\n .bd-hero-history-column .et_pb_slider,.bd-hero-history-column .et_pb_slider_container{width:100%!important;max-width:none!important;margin-left:0!important;margin-right:0!important;} .bd-hero-history-column .et-pb-arrow-prev{left:10px!important;} .bd-hero-history-column .et-pb-arrow-next{right:10px!important;} </style>\n<dialog id=\"bdstar-video\" aria-label=\"BD Star Transport video\">\n  <div id=\"bdstar-video-dialog\">\n    <button id=\"bd-video-modal-close\" type=\"button\" aria-label=\"Close video\">\u00d7</button>\n    <video id=\"bd-modal-video\" controls playsinline preload=\"metadata\" poster=\"https://wordpress-868870-6701729.cloudwaysapps.com/wp-content/uploads/2026/09/airport.png\">\n      <source src=\"https://bdstartransport.com/video/vid.mp4\" type=\"video/mp4\">\n      Your browser does not support the video tag.\n    </video>\n    <button id=\"bd-video-poster\" type=\"button\" aria-label=\"Play BD Star Transport video\">\n      <img src=\"https://wordpress-868870-6701729.cloudwaysapps.com/wp-content/uploads/2026/09/airport.png\" alt=\"Family arriving at Punta Cana airport\">\n      <span id=\"bd-video-play-icon\" aria-hidden=\"true\">\u25b6</span>\n      <span id=\"bd-video-play-label\">Play Our Story</span>\n    </button>\n  </div>\n</dialog>\n<script>\n(function(){\n  var modal=document.getElementById('bdstar-video');\n  var video=document.getElementById('bd-modal-video');\n  var poster=document.getElementById('bd-video-poster');\n  var close=document.getElementById('bd-video-modal-close');\n  var lastFocus=null;\n  if(!modal||!video||!poster||!close)return;\n  document.body.appendChild(modal);\n  function positionOpener(){\n    var opener=Array.prototype.slice.call(document.querySelectorAll('a')).find(function(link){return link.getAttribute('href')==='#bdstar-video';});\n    if(!opener)return;\n    var wrapper=opener.closest('.et_pb_button_module_wrapper')||opener.parentElement;\n    var column=opener.closest('.et_pb_column');\n    if(column)column.style.setProperty('justify-content','flex-start','important');\n    if(wrapper){\n      ['position','top','left','transform','width','max-width','margin','z-index'].forEach(function(property){wrapper.style.removeProperty(property);});\n      wrapper.style.setProperty('margin-top','18px','important');\n      wrapper.style.setProperty('margin-right','auto','important');\n      wrapper.style.setProperty('margin-bottom','0','important');\n      wrapper.style.setProperty('margin-left','auto','important');\n    }\n  }\n  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',positionOpener);\n  else positionOpener();\n  function openModal(event){\n    if(event)event.preventDefault();\n    lastFocus=document.activeElement;\n    document.body.classList.add('bd-video-modal-open');\n    poster.hidden=false;\n    if(!modal.open)modal.showModal();\n    poster.focus();\n  }\n  function closeModal(){\n    video.pause();\n    try{video.currentTime=0;}catch(error){}\n    poster.hidden=false;\n    document.body.classList.remove('bd-video-modal-open');\n    if(modal.open)modal.close();\n    if(lastFocus)lastFocus.focus();\n  }\n  function playVideo(){\n    poster.hidden=true;\n    var request=video.play();\n    if(request&&request.catch)request.catch(function(){video.controls=true;});\n  }\n  document.addEventListener('click',function(event){\n    var opener=event.target.closest&&event.target.closest('a[href=\"#bdstar-video\"]');\n    if(opener)openModal(event);\n  },true);\n  poster.addEventListener('click',playVideo);\n  close.addEventListener('click',closeModal);\n  video.addEventListener('ended',function(){poster.hidden=false;});\n  modal.addEventListener('cancel',function(event){event.preventDefault();closeModal();});\n  modal.addEventListener('click',function(event){\n    var rect=modal.getBoundingClientRect();\n    if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)closeModal();\n  });\n})();\n</script>"}}},"builderVersion":"5.0.0-public-beta.1"} /-->
<!-- /wp:divi/column -->
<!-- /wp:divi/row -->
<!-- wp:divi/code {"module":{"meta":{"adminLabel":{"desktop":{"value":"Services Hero Top Center Entrance"}}}},"content":{"innerContent":{"desktop":{"value":"<style>@keyframes bdServicesHeroTopCenter{from{transform:translate3d(0,-16px,0);transform-origin:50% 0;}to{transform:translate3d(0,0,0);transform-origin:50% 0;}}.bd-services-hero{animation:bdServicesHeroTopCenter .7s cubic-bezier(.22,.61,.36,1) both;transform-origin:50% 0;}@media(prefers-reduced-motion:reduce){.bd-services-hero{animation:none;}}</style>"}}},"builderVersion":"5.11.1"} /-->
<!-- wp:divi/code {"module":{"meta":{"adminLabel":{"desktop":{"value":"Services Hero Text Motion"}}}},"content":{"innerContent":{"desktop":{"value":"<style>@keyframes bdServicesHeroCopyRise{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}#main-content .et_pb_section_0 .et_pb_column.bd-services-hero-copy-column.et-animated--vb{animation:none!important;transition:none!important;transform:none!important;opacity:1!important;}#main-content .et_pb_section_0 .et_pb_text.bd-services-hero-text-enter,#main-content .et_pb_section_0 .et_pb_text.bd-services-hero-text-enter.et-animated--vb{animation:bdServicesHeroCopyRise .68s cubic-bezier(.22,.61,.36,1) var(--bd-services-hero-text-delay,0ms) both!important;transition:none!important;will-change:opacity,transform;}@media(prefers-reduced-motion:reduce){#main-content .et_pb_section_0 .et_pb_text.bd-services-hero-text-enter,#main-content .et_pb_section_0 .et_pb_text.bd-services-hero-text-enter.et-animated--vb{animation:none!important;opacity:1!important;transform:none!important;will-change:auto;}}</style><script>(function(){var self=document.currentScript;function warn(message){if(window.console&&console.warn)console.warn('[BD Star Services hero motion] '+message);}function bind(){var section=(self&&self.closest('.et_pb_section'))||document.querySelector('#main-content .et_pb_section_0');if(!section){warn('Services hero section not found');return;}var row=section.querySelector('.et_pb_row_0');if(!row){warn('Services hero row not found');return;}var copy=[...row.children].find(function(node){return node.classList.contains('et_pb_column');});if(!copy){warn('Services hero copy column not found');return;}var nodes=copy.querySelectorAll(':scope > .et_pb_text');if(!nodes.length){warn('Services hero copy has no direct text modules');return;}copy.classList.add('bd-services-hero-copy-column');nodes.forEach(function(node,index){node.classList.add('bd-services-hero-text-enter');node.style.setProperty('--bd-services-hero-text-delay',(index*120)+'ms');});}bind();window.addEventListener('et_builder_api_ready',bind);})();</script>"}}},"builderVersion":"5.11.1"} /-->
