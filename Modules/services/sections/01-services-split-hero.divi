ices-hero-text-delay',(index*120)+'ms');});}bind();window.addEventListener('et_builder_api_ready',bind);})();</script>"}}},"builderVersion":"5.11.1"} /-->
<!-- wp:divi/code {"module":{"meta":{"adminLabel":{"desktop":{"value":"Mobile Hero Spacing"}}}},"content":{"innerContent":{"desktop":{"value":"<style id=\"bd-mobile-hero-spacing\">@media(max-width:767px){#main-content .et_pb_section_0.et_pb_section:not(.is-contact-fullscreen) .et_pb_row_0.et_pb_row:not(.is-form-open){row-gap:0!important;}#main-content .et_pb_section_0.et_pb_section:not(.is-contact-fullscreen) .et_pb_row_0.et_pb_row:not(.is-form-open)>.et_pb_column:nth-child(1){height:auto!important;min-height:0!important;margin-bottom:0!important;padding-bottom:0!important;}#main-content .et_pb_section_0.et_pb_section:not(.is-contact-fullscreen) .et_pb_row_0.et_pb_row:not(.is-form-open)>.et_pb_column:nth-child(1)>.et_pb_button_module_wrapper:last-child{margin-bottom:0!important;}#main-content .et_pb_section_0.et_pb_section:not(.is-contact-fullscreen) .et_pb_row_0.et_pb_row:not(.is-form-open)>.et_pb_column:nth-child(2){margin-top:0!important;padding-top:16px!important;}#main-content .et_pb_section_0.et_pb_section:not(.is-contact-fullscreen) .et_pb_row_0.et_pb_row:not(.is-form-open) .et_pb_slider_0{margin-top:0!important;}}</style>"}}},"builderVersion":"5.11.1"} /-->
