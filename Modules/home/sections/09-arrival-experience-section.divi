<!-- wp:divi/text {"module":{"meta":{"adminLabel":{"desktop":{"value":"Step 3 Text"}}},"decoration":{"layout":{"desktop":{"value":{"display":"block"}}}}},"content":{"innerContent":{"desktop":{"value":"<span style=\"display:block;font-family:Montserrat,sans-serif;font-size:11px;font-weight:700;color:#141630;letter-spacing:1px;text-transform:uppercase;margin-bottom:2px;\">STEP 03 \u2022 ON THE ROAD</span><h3 style=\"margin:0 0 5px;font-family:Montserrat,sans-serif;font-size:17px;font-weight:700;color:#353740;line-height:1.25em;\">Direct, Relaxing Resort Ride</h3><p style=\"margin:0;font-family:Montserrat,sans-serif;font-weight:400;color:#747d88;font-size:14px;line-height:1.55em;\">Step into a cool, air-conditioned vehicle. Enjoy chilled bottled water, relax in comfortable seating, and head straight to your resort without unwanted detours.</p>"}}},"builderVersion":"5.11.1"} /-->
