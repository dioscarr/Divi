<!-- wp:divi/code {"module":{"meta":{"adminLabel":{"desktop":{"value":"Home Photo Gallery"}}}},"builderVersion":"5.11.1","content":{"innerContent":{"desktop":{"value":"<style>\n.bd-home-gallery{max-width:1440px;margin:0 auto;}.bd-home-gallery-preview-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;margin-bottom:18px;}.bd-home-gallery-preview{display:block;position:relative;aspect-ratio:1/1.18;padding:0;overflow:hidden;border:1px solid #d9dee7;border-radius:8px;background:#232648;cursor:pointer;}.bd-home-gallery-preview img,.bd-home-gallery-tile img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s ease;}.bd-home-gallery-preview:hover img,.bd-home-gallery-preview:focus-visible img,.bd-home-gallery-tile:hover img,.bd-home-gallery-tile:focus-visible img{transform:scale(1.06);}.bd-home-gallery-preview:hover,.bd-home-gallery-preview:focus-visible{border-color:#de7e0a;outline:0;}.bd-home-gallery-action{display:flex;justify-content:center;}.bd-home-gallery-open{display:inline-flex;align-items:center;gap:10px;padding:13px 19px;border:2px solid #141630;border-radius:8px;background:transparent;color:#141630;font:700 13px/1 Montserrat,Arial,sans-serif;letter-spacing:.8px;text-transform:uppercase;cursor:pointer;transition:background .2s,border-color .2s,color .2s;}.bd-home-gallery-open:hover,.bd-home-gallery-open:focus-visible{background:#de7e0a;border-color:#de7e0a;color:#fff;outline:0;}.bd-home-gallery-modal{position:fixed;z-index:999999;inset:0;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(10,12,28,.76);opacity:0;visibility:hidden;transition:opacity .25s ease,visibility 0s linear .25s;}.bd-home-gallery-modal.is-open{opacity:1;visibility:visible;transition:opacity .25s ease;}.bd-home-gallery-panel{display:flex;position:relative;box-sizing:border-box;width:min(100%,1120px);max-height:min(780px,calc(100dvh - 48px));flex-direction:column;padding:24px;background:#141630;border:1px solid rgba(255,255,255,.18);border-radius:12px;box-shadow:0 24px 65px rgba(0,0,0,.42);color:#fff;transform:translateY(16px);transition:transform .3s cubic-bezier(.22,.61,.36,1);}.bd-home-gallery-modal.is-open .bd-home-gallery-panel{transform:none;}.bd-home-gallery-top{display:flex;align-items:start;justify-content:space-between;gap:18px;margin-bottom:18px;}.bd-home-gallery-kicker{display:block;margin-bottom:7px;color:#f3a33d;font:700 11px/1 Montserrat,Arial,sans-serif;letter-spacing:1.2px;text-transform:uppercase;}.bd-home-gallery-title{margin:0;color:#fff;font:700 25px/1.2 Montserrat,Arial,sans-serif;}.bd-home-gallery-close,.bd-home-gallery-nav{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:50%;background:#fff;color:#141630;cursor:pointer;}.bd-home-gallery-close{width:38px;height:38px;flex:0 0 38px;font:700 24px/1 Arial,sans-serif;}.bd-home-gallery-close:hover,.bd-home-gallery-close:focus-visible,.bd-home-gallery-nav:hover,.bd-home-gallery-nav:focus-visible{background:#de7e0a;color:#fff;outline:0;}.bd-home-gallery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;overflow:auto;padding-right:4px;}.bd-home-gallery-tile{display:block;aspect-ratio:1/1.18;padding:0;overflow:hidden;border:1px solid rgba(255,255,255,.2);border-radius:8px;background:#232648;cursor:pointer;}.bd-home-gallery-tile:focus-visible{border-color:#de7e0a;outline:2px solid #de7e0a;outline-offset:2px;}.bd-home-gallery-view{display:none;position:absolute;z-index:2;inset:0;align-items:center;justify-content:center;padding:74px 72px 24px;background:#141630;border-radius:12px;}.bd-home-gallery-modal.is-viewing .bd-home-gallery-view{display:flex;}.bd-home-gallery-stage{max-width:100%;max-height:100%;object-fit:contain;border-radius:8px;}.bd-home-gallery-nav{position:absolute;top:50%;width:44px;height:44px;margin-top:16px;font:700 28px/1 Arial,sans-serif;}.bd-home-gallery-prev{left:18px;}.bd-home-gallery-next{right:18px;}.bd-home-gallery-back{position:absolute;top:24px;left:24px;border:0;background:transparent;color:#fff;font:700 13px/1 Montserrat,Arial,sans-serif;letter-spacing:.7px;text-transform:uppercase;cursor:pointer;}.bd-home-gallery-back:hover,.bd-home-gallery-back:focus-visible{color:#f3a33d;outline:0;}html[data-bd-theme='dark'] .bd-home-gallery-section{background:#141630!important;}html[data-bd-theme='dark'] .bd-home-gallery-section h2{color:#ffffff!important;}html[data-bd-theme='dark'] .bd-home-gallery-section p{color:#f0a03a!important;}html[data-bd-theme='dark'] .bd-home-gallery-preview{border-color:#464a70;}html[data-bd-theme='dark'] .bd-home-gallery-open{border-color:#f4f6fb;color:#f4f6fb;}@media(max-width:767px){.bd-home-gallery-preview-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;}.bd-home-gallery-modal{padding:12px;}.bd-home-gallery-panel{max-height:calc(100dvh - 24px);padding:18px;border-radius:8px;}.bd-home-gallery-title{font-size:21px;}.bd-home-gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;}.bd-home-gallery-view{padding:66px 44px 18px;border-radius:8px;}.bd-home-gallery-nav{width:38px;height:38px;}.bd-home-gallery-prev{left:8px;}.bd-home-gallery-next{right:8px;}.bd-home-gallery-back{top:20px;left:18px;}}\n</style>\n<div class=\"bd-home-gallery\"><div class=\"bd-home-gallery-preview-grid\"><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"0\" aria-label=\"View photo 1\"><img loading=\"lazy\" src=\"https://cdn.sanity.io/images/lxncf579/production/990ec5e2180460c59dcd81930056d59112179b0b-1536x1024.png?auto=format\" alt=\"Dominican Republic destination 1\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"1\" aria-label=\"View photo 2\"><img loading=\"lazy\" src=\"https://images.unsplash.com/photo-1607642857266-88f5f03e66c6?auto=format\" alt=\"Dominican Republic destination 2\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"2\" aria-label=\"View photo 3\"><img loading=\"lazy\" src=\"https://images.myguide-cdn.com/dominicanrepublic/activities/saona-island-small-group-virgin-beaches-cruise-day-trip/large/saona-island-small-group-virgin-beaches-cruise-day-trip-7283788.jpg\" alt=\"Dominican Republic destination 3\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"3\" aria-label=\"View photo 4\"><img loading=\"lazy\" src=\"https://images.unsplash.com/photo-1609769542735-3cfa075d9b70?auto=format\" alt=\"Dominican Republic destination 4\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"4\" aria-label=\"View photo 5\"><img loading=\"lazy\" src=\"https://images.unsplash.com/photo-1678816514479-a3feb75bbec9?auto=format\" alt=\"Dominican Republic destination 5\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"5\" aria-label=\"View photo 6\"><img loading=\"lazy\" src=\"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-720x480/0f/bd/40/8b.jpg\" alt=\"Dominican Republic destination 6\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"6\" aria-label=\"View photo 7\"><img loading=\"lazy\" src=\"https://cdn.getyourguide.com/image/format%3Dauto%2Cfit%3Dcrop%2Cgravity%3Dcenter%2Cquality%3D60%2Cwidth%3D450%2Cheight%3D450%2Cdpr%3D2/tour_img/af5f325358fec08b32b6ec15e85e307cf44952ef682b2f95c096b0b92c5f3b45.png\" alt=\"Dominican Republic destination 7\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"7\" aria-label=\"View photo 8\"><img loading=\"lazy\" src=\"https://wakacjeamigos.pl/uploads/blog/retina_aded4761-b750-4a37-93a2-252262227dd7.jpg\" alt=\"Dominican Republic destination 8\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"8\" aria-label=\"View photo 9\"><img loading=\"lazy\" src=\"https://cdn.travelersuniverse.com/media/santo-domingo-zona-colonial-guided-walking-tour-t629748-5.jpg\" alt=\"Dominican Republic destination 9\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"9\" aria-label=\"View photo 10\"><img loading=\"lazy\" src=\"https://wordpress-868870-6701729.cloudwaysapps.com/wp-content/uploads/2026/09/airport.png\" alt=\"Dominican Republic destination 10\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"10\" aria-label=\"View photo 11\"><img loading=\"lazy\" src=\"https://wordpress-868870-6701729.cloudwaysapps.com/wp-content/uploads/2026/09/family.png\" alt=\"Dominican Republic destination 11\"></button><button class=\"bd-home-gallery-preview\" type=\"button\" data-index=\"11\" aria-label=\"View photo 12\"><img loading=\"lazy\" src=\"https://wordpress-868870-6701729.cloudwaysapps.com/wp-content/uploads/2026/09/explore.png\" alt=\"Dominican Republic destination 12\"></button></div><div class=\"bd-home-gallery-action\"><button class=\"bd-home-gallery-open\" type=\"button\"><span aria-hidden=\"true\">&#9638;</span> See more images</button></div><div class=\"bd-home-gallery-modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Dominican Republic photo gallery\"><div class=\"bd-home-gallery-panel\"><div class=\"bd-home-gallery-top\"><div><span class=\"bd-home-gallery-kicker\">Dominican Republic</span><h3 class=\"bd-home-gallery-title\">Your trip starts here</h3></div><button class=\"bd-home-gallery-close\" type=\"button\" aria-label=\"Close gallery\">&times;</button></div><div class=\"bd-home-gallery-grid\"><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"0\" aria-label=\"View photo 1\"><img loading=\"lazy\" src=\"https://cdn.sanity.io/images/lxncf579/production/990ec5e2180460c59dcd81930056d59112179b0b-1536x1024.png?auto=format\" alt=\"Dominican Republic destination 1\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"1\" aria-label=\"View photo 2\"><img loading=\"lazy\" src=\"https://images.unsplash.com/photo-1607642857266-88f5f03e66c6?auto=format\" alt=\"Dominican Republic destination 2\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"2\" aria-label=\"View photo 3\"><img loading=\"lazy\" src=\"https://images.myguide-cdn.com/dominicanrepublic/activities/saona-island-small-group-virgin-beaches-cruise-day-trip/large/saona-island-small-group-virgin-beaches-cruise-day-trip-7283788.jpg\" alt=\"Dominican Republic destination 3\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"3\" aria-label=\"View photo 4\"><img loading=\"lazy\" src=\"https://images.unsplash.com/photo-1609769542735-3cfa075d9b70?auto=format\" alt=\"Dominican Republic destination 4\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"4\" aria-label=\"View photo 5\"><img loading=\"lazy\" src=\"https://images.unsplash.com/photo-1678816514479-a3feb75bbec9?auto=format\" alt=\"Dominican Republic destination 5\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"5\" aria-label=\"View photo 6\"><img loading=\"lazy\" src=\"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-720x480/0f/bd/40/8b.jpg\" alt=\"Dominican Republic destination 6\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"6\" aria-label=\"View photo 7\"><img loading=\"lazy\" src=\"https://cdn.getyourguide.com/image/format%3Dauto%2Cfit%3Dcrop%2Cgravity%3Dcenter%2Cquality%3D60%2Cwidth%3D450%2Cheight%3D450%2Cdpr%3D2/tour_img/af5f325358fec08b32b6ec15e85e307cf44952ef682b2f95c096b0b92c5f3b45.png\" alt=\"Dominican Republic destination 7\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"7\" aria-label=\"View photo 8\"><img loading=\"lazy\" src=\"https://wakacjeamigos.pl/uploads/blog/retina_aded4761-b750-4a37-93a2-252262227dd7.jpg\" alt=\"Dominican Republic destination 8\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"8\" aria-label=\"View photo 9\"><img loading=\"lazy\" src=\"https://cdn.travelersuniverse.com/media/santo-domingo-zona-colonial-guided-walking-tour-t629748-5.jpg\" alt=\"Dominican Republic destination 9\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"9\" aria-label=\"View photo 10\"><img loading=\"lazy\" src=\"https://wordpress-868870-6701729.cloudwaysapps.com/wp-content/uploads/2026/09/airport.png\" alt=\"Dominican Republic destination 10\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"10\" aria-label=\"View photo 11\"><img loading=\"lazy\" src=\"https://wordpress-868870-6701729.cloudwaysapps.com/wp-content/uploads/2026/09/family.png\" alt=\"Dominican Republic destination 11\"></button><button class=\"bd-home-gallery-tile\" type=\"button\" data-index=\"11\" aria-label=\"View photo 12\"><img loading=\"lazy\" src=\"https://wordpress-868870-6701729.cloudwaysapps.com/wp-content/uploads/2026/09/explore.png\" alt=\"Dominican Republic destination 12\"></button></div><div class=\"bd-home-gallery-view\"><button class=\"bd-home-gallery-back\" type=\"button\">&#8592; All photos</button><img class=\"bd-home-gallery-stage\" src=\"\" alt=\"\"><button class=\"bd-home-gallery-nav bd-home-gallery-prev\" type=\"button\" aria-label=\"Previous photo\">&#8249;</button><button class=\"bd-home-gallery-nav bd-home-gallery-next\" type=\"button\" aria-label=\"Next photo\">&#8250;</button></div></div></div></div>\n<script>(function(){function setup(gallery){if(gallery.dataset.ready)return;var open=gallery.querySelector('.bd-home-gallery-open'),previews=Array.prototype.slice.call(gallery.querySelectorAll('.bd-home-gallery-preview'));if(!open)return;var modal=gallery.querySelector('.bd-home-gallery-modal');if(!modal){modal=document.createElement('div');modal.className='bd-home-gallery-modal';modal.setAttribute('role','dialog');modal.setAttribute('aria-modal','true');modal.setAttribute('aria-label','Dominican Republic photo gallery');modal.innerHTML='<div class=\"bd-home-gallery-panel\"><div class=\"bd-home-gallery-top\"><div><span class=\"bd-home-gallery-kicker\">Dominican Republic</span><h3 class=\"bd-home-gallery-title\">Your trip starts here</h3></div><button class=\"bd-home-gallery-close\" type=\"button\" aria-label=\"Close gallery\">&times;</button></div><div class=\"bd-home-gallery-grid\"></div><div class=\"bd-home-gallery-view\"><button class=\"bd-home-gallery-back\" type=\"button\">&#8592; All photos</button><img class=\"bd-home-gallery-stage\" src=\"\" alt=\"\"><button class=\"bd-home-gallery-nav bd-home-gallery-prev\" type=\"button\" aria-label=\"Previous photo\">&#8249;</button><button class=\"bd-home-gallery-nav bd-home-gallery-next\" type=\"button\" aria-label=\"Next photo\">&#8250;</button></div></div>';var grid=modal.querySelector('.bd-home-gallery-grid');previews.forEach(function(preview,index){var tile=document.createElement('button');tile.className='bd-home-gallery-tile';tile.type='button';tile.dataset.index=String(index);tile.setAttribute('aria-label','View photo '+(index+1));var image=preview.querySelector('img');if(image)tile.appendChild(image.cloneNode(true));grid.appendChild(tile);});gallery.appendChild(modal);}var close=modal.querySelector('.bd-home-gallery-close'),back=modal.querySelector('.bd-home-gallery-back'),stage=modal.querySelector('.bd-home-gallery-stage'),tiles=Array.prototype.slice.call(modal.querySelectorAll('.bd-home-gallery-tile')),current=0,lastFocus;if(!close||!back||!stage||!tiles.length){if(window.console&&console.warn)console.warn('[BD Star gallery] lightbox markup is incomplete');return;}gallery.dataset.ready='1';document.body.appendChild(modal);function show(index){current=(index+tiles.length)%tiles.length;var image=tiles[current].querySelector('img');if(!image)return;stage.src=image.src;stage.alt=image.alt;modal.classList.add('is-viewing');}function closeView(){modal.classList.remove('is-viewing');}function openGallery(){lastFocus=document.activeElement;modal.classList.add('is-open');open.setAttribute('aria-expanded','true');close.focus();}function closeGallery(){closeView();modal.classList.remove('is-open');open.setAttribute('aria-expanded','false');(lastFocus||open).focus();}open.setAttribute('aria-expanded','false');open.addEventListener('click',openGallery);close.addEventListener('click',closeGallery);modal.addEventListener('click',function(event){if(event.target===modal)closeGallery();});back.addEventListener('click',closeView);tiles.forEach(function(tile,index){tile.addEventListener('click',function(){show(index);});});previews.forEach(function(preview){preview.addEventListener('click',function(){openGallery();show(Number(preview.dataset.index));});});modal.querySelector('.bd-home-gallery-prev').addEventListener('click',function(){show(current-1);});modal.querySelector('.bd-home-gallery-next').addEventListener('click',function(){show(current+1);});document.addEventListener('keydown',function(event){if(!modal.classList.contains('is-open'))return;if(event.key==='Escape'){if(modal.classList.contains('is-viewing'))closeView();else closeGallery();}if(modal.classList.contains('is-viewing')&&event.key==='ArrowLeft')show(current-1);if(modal.classList.contains('is-viewing')&&event.key==='ArrowRight')show(current+1);});}function init(){document.querySelectorAll('.bd-home-gallery').forEach(setup);}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();window.addEventListener('et_builder_api_ready',init);})();</script>"}}}} /-->
