<!-- wp:divi/code {"module":{"meta":{"adminLabel":{"desktop":{"value":"Premium Service Card Links"}}}},"content":{"innerContent":{"desktop":{"value":"<style>.bd-premium-service-card{cursor:pointer;}</style><script>(function(){function bind(){document.querySelectorAll('.bd-premium-service-card').forEach(function(card){if(card.dataset.bdServiceLinkBound)return;card.dataset.bdServiceLinkBound='1';card.setAttribute('role','link');card.setAttribute('tabindex','0');var title=card.querySelector('.et_pb_module_header');if(title)card.setAttribute('aria-label','Open '+title.textContent.trim());function go(event){if(event.target.closest&&event.target.closest('a,button,input,textarea,select'))return;var text=title?title.textContent.trim():'';var href=text.indexOf('Airport')===0?'/services?section=airport-transfers':text.indexOf('Family')===0?'/services?section=family-trips':'/services?section=tours-excursions';window.location.href=href;}card.addEventListener('click',go);card.addEventListener('keydown',function(event){if(event.key==='Enter'||event.key===' '){event.preventDefault();go(event);}});});}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind);else bind();window.addEventListener('et_builder_api_ready',bind);setTimeout(bind,300);})();</script>"}}},"builderVersion":"5.11.1"} /-->
