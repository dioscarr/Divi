<!-- wp:divi/code {"module":{"meta":{"adminLabel":{"desktop":{"value":"Home Destination Links"}}}},"content":{"innerContent":{"desktop":{"value":"<style>\n.bd-home-pathways{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:0 auto;max-width:1060px;}\n.bd-home-pathway{display:flex;min-height:210px;box-sizing:border-box;flex-direction:column;justify-content:space-between;padding:26px;background:#ffffff;border:1px solid #d9dee7;border-radius:8px;color:#141630!important;text-decoration:none!important;transition:transform .24s ease,box-shadow .24s ease,border-color .24s ease;}\n.bd-home-pathway:hover,.bd-home-pathway:focus-visible{transform:translateY(-4px);border-color:#de7e0a;box-shadow:0 12px 26px rgba(20,22,48,.14);outline:0;}\n.bd-home-pathway-kicker{display:block;margin-bottom:12px;color:#de7e0a;font:700 11px/1.2 Montserrat,Arial,sans-serif;letter-spacing:1.2px;text-transform:uppercase;}\n.bd-home-pathway h3{margin:0 0 10px;color:#141630;font:700 22px/1.25 Montserrat,Arial,sans-serif;}\n.bd-home-pathway p{margin:0;color:#697386;font:400 15px/1.65 Montserrat,Arial,sans-serif;}\n.bd-home-pathway-link{display:block;margin-top:22px;color:#141630;font:700 13px/1.2 Montserrat,Arial,sans-serif;letter-spacing:.6px;text-transform:uppercase;}\n.bd-home-pathway:hover .bd-home-pathway-link{color:#de7e0a;}\nhtml[data-bd-theme='dark'] .bd-home-destination-section{background:#141630!important;}\nhtml[data-bd-theme='dark'] .bd-home-destination-section h2{color:#ffffff!important;}\nhtml[data-bd-theme='dark'] .bd-home-pathway{background:#232648;border-color:#464a70;color:#ffffff!important;}\nhtml[data-bd-theme='dark'] .bd-home-pathway h3,html[data-bd-theme='dark'] .bd-home-pathway-link{color:#ffffff;}\nhtml[data-bd-theme='dark'] .bd-home-pathway p{color:#c7cfdd;}\nhtml[data-bd-theme='dark'] .bd-home-pathway:hover,html[data-bd-theme='dark'] .bd-home-pathway:focus-visible{border-color:#f0a03a;box-shadow:0 12px 26px rgba(0,0,0,.32);}\nhtml[data-bd-theme='dark'] .bd-home-pathway:hover .bd-home-pathway-link{color:#f0a03a;}\n@media(max-width:767px){.bd-home-pathways{grid-template-columns:1fr;gap:12px;}.bd-home-pathway{min-height:0;padding:22px;}.bd-home-pathway-link{margin-top:18px;}}\n</style>\n<div class=\"bd-home-pathways\">\n  <a class=\"bd-home-pathway\" href=\"/about\"><div><span class=\"bd-home-pathway-kicker\">Our story</span><h3>Meet B.D Star</h3><p>Learn about the people, values, and experience behind every ride.</p></div><span class=\"bd-home-pathway-link\">About us &rarr;</span></a>\n  <a class=\"bd-home-pathway\" href=\"/services\"><div><span class=\"bd-home-pathway-kicker\">Plan your route</span><h3>Explore Services</h3><p>Find the transportation option that fits your arrival, family, or adventure.</p></div><span class=\"bd-home-pathway-link\">View services &rarr;</span></a>\n  <a class=\"bd-home-pathway\" href=\"/contact\"><div><span class=\"bd-home-pathway-kicker\">Ready when you are</span><h3>Request a Ride</h3><p>Tell us where you are going and we will help make the trip easy.</p></div><span class=\"bd-home-pathway-link\">Contact B.D Star &rarr;</span></a>\n</div>"}}},"builderVersion":"5.11.1"} /-->
<!-- /wp:divi/column -->
<!-- /wp:divi/row -->
