<!-- wp:divi/code {"module":{"meta":{"adminLabel":{"desktop":{"value":"Home Hero Top Center Entrance"}}}},"content":{"innerContent":{"desktop":{"value":"<style>@keyframes bdHomeHeroCopyTopDown{from{opacity:0;transform:translateY(-12px);}to{opacity:1;transform:translateY(0);}}.bd-home-hero-copy-top-down{animation:bdHomeHeroCopyTopDown .62s cubic-bezier(.22,.61,.36,1) both!important;backface-visibility:hidden;transform-origin:50% 0;will-change:opacity,transform;}@media(prefers-reduced-motion:reduce){.bd-home-hero-copy-top-down{animation:none!important;opacity:1!important;transform:none!important;will-change:auto;}}</style><script>(function(){function bind(){var slider=document.querySelector('.bd-hero-history-column'),row=slider&&slider.closest('.et_pb_row'),copy=row&&row.querySelector(':scope > .et_pb_column:first-child');if(!copy)return;copy.querySelectorAll(':scope > .et_pb_text').forEach(function(node){node.classList.add('bd-home-hero-copy-top-down');});}bind();window.addEventListener('et_builder_api_ready',bind);})();</script>"}}},"builderVersion":"5.11.1"} /-->
