<!-- wp:divi/button  {"module":{"decoration":{"layout":{"desktop":{"value":{"display":"block"}}},"sizing":{"desktop":{"value":{"alignment":"center"}}}},"attributes":{"desktop":{"value":{"attributes":[{"id":"bdstar-hero-history-button","name":"class","value":"bd-hero-history-button","adminLabel":"CSS Class"}]}}}},"button":{"innerContent":{"desktop":{"value":{"linkUrl":"#bdstar-video","text":"Watch Our History"}},"phone":{"value":{"linkUrl":"#bdstar-video","text":"Watch History"}}},"decoration":{"button":{"desktop":{"value":{"enable":"on","icon":{"settings":{"unicode":"&#x45;","type":"divi","weight":"400"}}}}},"font":{"font":{"desktop":{"value":{"color":"#ffffff","letterSpacing":"2px","family":"Montserrat","weight":"700","capitalization":"uppercase","size":"14px","lineHeight":"1.2em"},"hover":{"color":"#ffffff","letterSpacing":"2px"}},"phone":{"value":{"color":"#ffffff","letterSpacing":"0.8px","family":"Montserrat","weight":"700","capitalization":"uppercase","size":"12px","lineHeight":"1.25em","textWrap":"nowrap"}}}},"border":{"desktop":{"value":{"styles":{"all":{"width":"4px","color":"#ffffff"}},"radius":{"sync":"on","topLeft":"100px","topRight":"100px","bottomRight":"100px","bottomLeft":"100px"}},"hover":{"styles":{"all":{"color":"#ffffff"}}}}},"background":{"desktop":{"hover":{"color":"rgba(20,22,48,0.68)","enableColor":"on"},"value":{"color":"rgba(20,22,48,0.48)"}}},"spacing":{"phone":{"value":{"padding":{"top":"12px","right":"16px","bottom":"12px","left":"16px","syncVertical":"on","syncHorizontal":"on"}}}}}},"builderVersion":"5.0.0-public-beta.1","locked":{"desktop":{"value":"off"}}} /--><!-- /wp:divi/column -->
